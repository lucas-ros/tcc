{
	"version": "2.0.0",
	"tasks": [
		{
			// USING WITH MCUBOOT DISABLE
			"hide": false,
			"label": "west_build_production",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-p",
				"-b",
				"nucleo_f410rb"
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			// USING WITH MCUBOOT DISABLE
			"hide": false,
			"label": "west_build_production_old",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-p",
				"-b",
				"nucleo_h753zi"
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			// USING WITH MCUBOOT DISABLE
			"hide": false,
			"label": "west_build_debug",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-b",
				"nucleo_f410rb",
				"-o=-j$(nproc)",
				"-p",
				"--",
				"-DBUILD_TYPE=debug"
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			// USING WITH MCUBOOT DISABLE
			"hide": false,
			"label": "west_build_debug_old",
			"type": "shell",
			"group": "build",
			"command": "west",
			"args": [
				"build",
				"-b",
				"nucleo_h753zi",
				"-o=-j$(nproc)",
				"-p",
				"--",
				"-DBUILD_TYPE=debug"
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "west_flash_stlink",
			"type": "shell",
			"command": "west",
			"args": [
				"flash"
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "west_flash_jlink",
			"type": "shell",
			"command": "west",
			"args": [
				"flash",
				"--runner",
				"jlink"
			],
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "seq_build_debug_and_flash_stlink",
			"dependsOrder": "sequence",
			"dependsOn": [
				"west_build_debug",
				"west_flash_stlink"
			]
		},
		{
			"label": "seq_build_debug_and_flash_old",
			"dependsOrder": "sequence",
			"dependsOn": [
				"west_build_debug_old",
				"west_flash_stlink"
			]
		},
		{
			"label": "seq_build_debug_and_flash_jlink",
			"dependsOrder": "sequence",
			"dependsOn": [
				"west_build_debug",
				"west_flash_jlink"
			]
		},
		{
			// USING WITH MCUBOOT DISABLE
			"hide": false,
			"label": "west_status",
			"type": "shell",
			"group": "build",
			"command": "west forall -c \"git diff\"",
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			// USING WITH MCUBOOT DISABLE
			"hide": false,
			"label": "west_checkout",
			"type": "shell",
			"group": "build",
			"command": "west forall -c \"git checkout ./\"",
			"problemMatcher": [
				"$gcc"
			]
		},
	]
}